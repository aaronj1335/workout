{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aaronj1335.github.io/workout/workout.schema.json",
  "title": "Workout",
  "description": "One workout: a named, ordered list of steps, each repeated a number of times.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable slug. Defaults to the YAML file name.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Shown in the watch list. Keep it short enough to read on a watch."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reps"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "reps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    }
  }
}
