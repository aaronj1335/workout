load("@bazel_skylib//rules:build_test.bzl", "build_test")

filegroup(
    name = "workouts",
    srcs = glob(
        [
            "*.yaml",
            "*.yml",
        ],
        allow_empty = True,
    ),
    visibility = ["//src:__pkg__"],
)

# The files published on GitHub Pages: bazel-bin/workouts/dist/{workouts.json,index.html}
genrule(
    name = "dist",
    srcs = [":workouts"],
    outs = [
        "dist/workouts.json",
        "dist/index.html",
    ],
    cmd = "$(execpath //src:build_workouts) --out $(RULEDIR)/dist $(SRCS)",
    tools = ["//src:build_workouts"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "dist_build_test",
    targets = [":dist"],
)
