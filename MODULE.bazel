"""Workout: a Wear OS app plus the tooling that publishes its workout catalog."""

module(name = "workout")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_kotlin", version = "2.4.20")
bazel_dep(name = "rules_android", version = "0.7.3")
bazel_dep(name = "rules_jvm_external", version = "7.1")

# ---------------------------------------------------------------------------
# Android SDK, downloaded on demand so a fresh checkout (or a CI runner) builds
# without Android Studio. Accepting the SDK license is done in .bazelrc.
# ---------------------------------------------------------------------------
# (hermetic_android_toolchains insists on being a dev_dependency; for the
# root module that changes nothing.)
bazel_dep(name = "hermetic_android_toolchains", version = "0.4.0", dev_dependency = True)

android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(
    build_tools_version = "37.0.0",
    version = "37.0",
)
use_repo(android, "androidsdk")

# Point @rules_android's @androidsdk at the hermetic SDK.
rules_android_sdk = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
    dev_dependency = True,
)
override_repo(rules_android_sdk, "androidsdk")

register_toolchains("@androidsdk//:all", dev_dependency = True)

# ---------------------------------------------------------------------------
# Maven dependencies for the app, at the versions the Gradle build resolved.
# ---------------------------------------------------------------------------
# Named workout_maven (and aliased to @maven below) so that other modules'
# maven.install(name = "maven") tags do not get merged into this resolution.
