# rules_kotlin ships its own (newer) stdlib and adds it to every Kotlin
# target; route Maven's transitive references there so the APK does not end
# up with two copies.
[
    maven.override(
        name = "workout_maven",
        coordinates = "org.jetbrains.kotlin:" + artifact,
        target = "@rules_kotlin//kotlin/compiler:" + artifact,
    )
    for artifact in [
        "kotlin-stdlib",
        "kotlin-stdlib-jdk7",
        "kotlin-stdlib-jdk8",
    ]
]

use_repo(maven, maven = "workout_maven")
