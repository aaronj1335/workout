load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_android//android:rules.bzl", "android_binary", "android_library")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")
load(":build_config.bzl", "build_config")

PACKAGE = "andersonstacy.workout"

# Sources follow the Bazel/Java convention: package andersonstacy.workout.foo
# lives in andersonstacy/workout/foo/, with tests next to the code they test.
PKG_DIR = "andersonstacy/workout"

TEST_SRCS = [PKG_DIR + "/**/*Test.kt"]

# The app is split so the pure-Kotlin parts can be unit tested without an
# Android runtime. Each library depends on the next through `deps`, not
# `associates`: nothing here is `internal` across a library boundary, and only
# deps, exports and runtime_deps are walked by the dex/desugar aspect that
# rewrites each jar's Java 8 bytecode for ART. A jar reachable only through
# `associates` is invisible to it and reaches the watch undesugared, where the
# first lambda it runs throws NoSuchMethodError on LambdaMetafactory.

# --- Pure Kotlin: catalog model, cache/refresh rules and the session state --

kt_jvm_library(
    name = "data",
    srcs = glob([PKG_DIR + "/data/*.kt"], exclude = TEST_SRCS),
    plugins = ["//:serialization_plugin"],
    deps = [
        "@maven//:com_squareup_okhttp3_okhttp",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json",
    ],
)

kt_jvm_library(
    name = "domain",
    srcs = glob([PKG_DIR + "/domain/*.kt"], exclude = TEST_SRCS),
    deps = [":data"],
)

# --- The Wear OS app ---------------------------------------------------------

build_config(
    name = "build_config",
    package = PACKAGE,
    workouts_url = "//:workouts_url",
)

kt_android_library(
    name = "lib",
    srcs = glob(
        [PKG_DIR + "/**/*.kt"],
        exclude = TEST_SRCS + [
            PKG_DIR + "/data/*.kt",
            PKG_DIR + "/domain/*.kt",
            PKG_DIR + "/tools/*.kt",
        ],
    ) + [":build_config"],
    manifest = "AndroidManifest.xml",
    plugins = ["//:compose_plugin"],
    resource_files = glob(["res/**"]),
    deps = [
        ":data",
        ":domain",
        "@maven//:androidx_activity_activity_compose",
        "@maven//:androidx_compose_material_material_icons_core",
        "@maven//:androidx_compose_ui_ui",
        "@maven//:androidx_compose_ui_ui_graphics",
        "@maven//:androidx_compose_ui_ui_tooling",
        "@maven//:androidx_compose_ui_ui_tooling_preview",
        "@maven//:androidx_core_core_splashscreen",
        "@maven//:androidx_lifecycle_lifecycle_runtime_compose",
        "@maven//:androidx_lifecycle_lifecycle_viewmodel_compose",
        "@maven//:androidx_wear_compose_compose_foundation",
        "@maven//:androidx_wear_compose_compose_material3",
        "@maven//:androidx_wear_compose_compose_navigation",
        "@maven//:androidx_wear_compose_compose_ui_tooling",
        "@maven//:androidx_wear_wear_tooling_preview",
        "@maven//:com_google_android_gms_play_services_wearable",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
    ],
)

# Debug builds may point at a plain-HTTP workouts.json served from a dev
# machine; release builds (-c opt) must not.
android_library(
    name = "debug_manifest",
    exports_manifest = True,
    manifest = "AndroidManifest.debug.xml",
)

config_setting(
    name = "release",
    values = {"compilation_mode": "opt"},
)

android_binary(
    name = "app",
    # Dex the whole program in one action. Per-jar dexing would be the more
    # granular choice, but rules_android hardcodes the per-jar dexer's minimum
    # API to the tool default (see min_sdk_version.clamp) and drops dexopts it
    # does not recognise, so those dex files would come out built for API 1.
    incremental_dexing = 0,
    # Whole-program dexing does not read minSdkVersion from the manifest.
    dexopts = ["--min-sdk-version=35"],
    manifest = "AndroidManifest.xml",
    visibility = ["//visibility:public"],
    deps = [":lib"] + select({
        ":release": [],
        "//conditions:default": [":debug_manifest"],
    }),
)

build_test(
    name = "app_build_test",
    targets = [":app"],
)

# A jar that misses the desugaring step builds and installs fine and only fails
# on the watch, so check the dex files that CI is about to publish.
kt_jvm_test(
    name = "ApkDesugaringTest",
    size = "small",
    srcs = [PKG_DIR + "/ApkDesugaringTest.kt"],
    data = [":app"],
    test_class = PACKAGE + ".ApkDesugaringTest",
    deps = ["@maven//:junit_junit"],
)

# --- Unit tests --------------------------------------------------------------

TEST_DEPS = [
    "@maven//:junit_junit",
    "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test",
]

kt_jvm_test(
    name = "WorkoutCatalogTest",
    size = "small",
    srcs = [PKG_DIR + "/data/WorkoutCatalogTest.kt"],
    test_class = PACKAGE + ".data.WorkoutCatalogTest",
    deps = [":data"] + TEST_DEPS,
)

kt_jvm_test(
    name = "WorkoutRepositoryTest",
    size = "small",
    srcs = [PKG_DIR + "/data/WorkoutRepositoryTest.kt"],
    test_class = PACKAGE + ".data.WorkoutRepositoryTest",
    deps = [":data"] + TEST_DEPS,
)

kt_jvm_test(
    name = "SessionStateTest",
    size = "small",
    srcs = [PKG_DIR + "/domain/SessionStateTest.kt"],
    test_class = PACKAGE + ".domain.SessionStateTest",
    deps = [":domain"] + TEST_DEPS,
)

kt_jvm_test(
    name = "DurationFormatTest",
    size = "small",
    srcs = [PKG_DIR + "/presentation/session/DurationFormatTest.kt"],
    # formatDuration is internal, so this test has to be part of the module.
    associates = [":lib"],
    test_class = PACKAGE + ".presentation.session.DurationFormatTest",
    deps = TEST_DEPS,
)

# --- The workout catalog compiler --------------------------------------------

# Reads workouts/*.yaml into the app's own catalog model (:data), so the JSON
# it writes is by construction the shape the watch parses.
kt_jvm_library(
    name = "build_workouts_lib",
    srcs = glob([PKG_DIR + "/tools/*.kt"], exclude = TEST_SRCS),
    deps = [
        ":data",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json",
        "@maven//:org_yaml_snakeyaml",
    ],
)

# Compiles workouts/*.yaml into workouts.json (+ index.html). See //workouts:dist.
java_binary(
    name = "build_workouts",
    main_class = PACKAGE + ".tools.MainKt",
    visibility = ["//workouts:__pkg__"],
    runtime_deps = [":build_workouts_lib"],
)

TOOLS_TEST_DEPS = [
    ":build_workouts_lib",
    ":data",
    "@maven//:junit_junit",
]

kt_jvm_test(
    name = "WorkoutFileTest",
    size = "small",
    srcs = [PKG_DIR + "/tools/WorkoutFileTest.kt"],
    test_class = PACKAGE + ".tools.WorkoutFileTest",
    deps = TOOLS_TEST_DEPS,
)

kt_jvm_test(
    name = "WorkoutCatalogBuilderTest",
    size = "small",
    srcs = [PKG_DIR + "/tools/WorkoutCatalogBuilderTest.kt"],
    test_class = PACKAGE + ".tools.WorkoutCatalogBuilderTest",
    deps = TOOLS_TEST_DEPS + ["@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json"],
)

# Validates every checked-in workout without writing anything.
kt_jvm_test(
    name = "validate_workouts_test",
    size = "small",
    srcs = [PKG_DIR + "/tools/ValidateWorkoutsTest.kt"],
    data = ["//workouts"],
    test_class = PACKAGE + ".tools.ValidateWorkoutsTest",
    deps = TOOLS_TEST_DEPS,
)
